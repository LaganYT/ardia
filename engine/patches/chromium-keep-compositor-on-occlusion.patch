An occluded window keeps its page's compositor and last frame (#662). A window whose Space goes out of view is
occluded, and after Chrome's occlusion delay `RenderWidgetHostViewMac::WasOccluded` hides the host, so
`BrowserCompositorMac::UpdateState` put the page's own compositor up for recycling: the NSView lost its layer
contents, and on return the page stayed blank until the renderer drew again (2-3 s in reports). Chrome's own pages
use their parent layer's compositor and keep their frame when only occluded; ArdiaCore's page views own theirs. Now
while the host is hidden but the view's root layer is still visible (occluded, not hidden), the compositor stays
(`BrowserCompositorMac::HoldForOcclusion`), and showing the host again re-shows the DelegatedFrameHost
(`BrowserCompositorMac::ShowHeld`). A real hide (the view made invisible) still retires the compositor as before.

--- a/content/browser/renderer_host/browser_compositor_view_mac.mm
+++ b/content/browser/renderer_host/browser_compositor_view_mac.mm
@@ -200,8 +200,15 @@
 }
 
 void BrowserCompositorMac::SetRenderWidgetHostIsHidden(bool hidden) {
+  const bool was_held =
+      state_ == HasOwnCompositor && render_widget_host_is_hidden_;
   render_widget_host_is_hidden_ = hidden;
   UpdateState();
+  if (was_held && !hidden && state_ == HasOwnCompositor) {
+    TRACE_EVENT_INSTANT("content", "BrowserCompositorMac::ShowHeld");
+    delegated_frame_host_->WasShown(GetRendererLocalSurfaceId(), dfh_size_dip_,
+                                    {});
+  }
   if (state_ == UseParentLayerCompositor) {
     if (!hidden) {
       // UpdateState might not call WasShown when showing a frame using the same
@@ -233,6 +240,10 @@
 
 void BrowserCompositorMac::SetViewVisible(bool visible) {
   root_layer_->SetVisible(visible);
+  if (!visible && render_widget_host_is_hidden_ &&
+      state_ == HasOwnCompositor) {
+    UpdateState();
+  }
 }
 
 void BrowserCompositorMac::UpdateState() {
@@ -248,6 +259,11 @@
     return;
   }
 
+  if (state_ == HasOwnCompositor && root_layer_->visible()) {
+    TRACE_EVENT_INSTANT("content", "BrowserCompositorMac::HoldForOcclusion");
+    return;
+  }
+
   // Otherwise put the compositor up for recycling.
   TransitionToState(HasNoCompositor);
 }
